# PATCH CONTEXT
# Why: viem@2.55.2 pins ox@0.14.30, whose KeyAuthorization.fromRpc
#   independently emits account and isAdmin even though its Signed type and
#   the TIP-1049 wire invariant require both fields or neither.
# Upstream Issue: https://github.com/wevm/ox/pull/291
# Linear Issue: none.
# Remove when: viem depends on an ox release containing wevm/ox#291.

diff --git a/node_modules/ox/_cjs/tempo/KeyAuthorization.js b/node_modules/ox/_cjs/tempo/KeyAuthorization.js
--- a/node_modules/ox/_cjs/tempo/KeyAuthorization.js
+++ b/node_modules/ox/_cjs/tempo/KeyAuthorization.js
@@ -76,6 +76,10 @@ function fromRpc(authorization) {
             }));
         })
         : undefined;
+    // TIP-1049 admin fields are paired: emit both or neither; orphan wire
+    // fields are dropped. Separate conditional spreads break `Signed`
+    // assignability without `exactOptionalPropertyTypes` (#290).
+    const adminPair = account !== undefined && isAdmin ? { account, isAdmin: true } : {};
     return {
         address: keyId,
         chainId: chainId === '0x' ? 0n : Hex.toBigInt(chainId),
@@ -91,8 +95,7 @@ function fromRpc(authorization) {
         signature,
         type: keyType,
         ...(witness !== undefined ? { witness } : {}),
-        ...(isAdmin ? { isAdmin: true } : {}),
-        ...(account !== undefined ? { account } : {}),
+        ...adminPair,
     };
 }
 function fromTuple(tuple) {
diff --git a/node_modules/ox/_esm/tempo/KeyAuthorization.js b/node_modules/ox/_esm/tempo/KeyAuthorization.js
--- a/node_modules/ox/_esm/tempo/KeyAuthorization.js
+++ b/node_modules/ox/_esm/tempo/KeyAuthorization.js
@@ -226,6 +226,10 @@ export function fromRpc(authorization) {
             }));
         })
         : undefined;
+    // TIP-1049 admin fields are paired: emit both or neither; orphan wire
+    // fields are dropped. Separate conditional spreads break `Signed`
+    // assignability without `exactOptionalPropertyTypes` (#290).
+    const adminPair = account !== undefined && isAdmin ? { account, isAdmin: true } : {};
     return {
         address: keyId,
         chainId: chainId === '0x' ? 0n : Hex.toBigInt(chainId),
@@ -241,8 +245,7 @@ export function fromRpc(authorization) {
         signature,
         type: keyType,
         ...(witness !== undefined ? { witness } : {}),
-        ...(isAdmin ? { isAdmin: true } : {}),
-        ...(account !== undefined ? { account } : {}),
+        ...adminPair,
     };
 }
 /**
diff --git a/node_modules/ox/tempo/KeyAuthorization.ts b/node_modules/ox/tempo/KeyAuthorization.ts
--- a/node_modules/ox/tempo/KeyAuthorization.ts
+++ b/node_modules/ox/tempo/KeyAuthorization.ts
@@ -534,6 +534,12 @@ export function fromRpc(authorization: Rpc): Signed {
       })
     : undefined
-
+
+  // TIP-1049 admin fields are paired: emit both or neither; orphan wire
+  // fields are dropped. Separate conditional spreads break `Signed`
+  // assignability without `exactOptionalPropertyTypes` (#290).
+  const adminPair =
+    account !== undefined && isAdmin ? { account, isAdmin: true as const } : {}
+
   return {
     address: keyId,
     chainId: chainId === '0x' ? 0n : Hex.toBigInt(chainId),
@@ -549,7 +555,6 @@ export function fromRpc(authorization: Rpc): Signed {
     signature,
     type: keyType,
     ...(witness !== undefined ? { witness } : {}),
-    ...(isAdmin ? { isAdmin: true } : {}),
-    ...(account !== undefined ? { account } : {}),
+    ...adminPair,
   }
 }
