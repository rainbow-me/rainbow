+class RNCWebViewRetainedContainerHostShadowNode final
+    : public ConcreteViewShadowNode<
+          RNCWebViewRetainedContainerComponentName,
+          RNCWebViewRetainedContainerProps,
+          RNCWebViewRetainedContainerEventEmitter,
