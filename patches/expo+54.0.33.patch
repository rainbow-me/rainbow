# PATCH CONTEXT
# Why: RN 0.87 removes legacy factory-delegate callbacks and starts roots
#   through the bundle/dev-menu-aware method. Expo 54 retains the removed
#   callbacks, relies on a transitive React import, includes an unavailable
#   generated Swift-header import, and only uses the old root-view dispatch.
#   Expo's current source owns the compatible boundary.
# Remove when: Expo's factory and root-view delegate use RN 0.87's contracts.

diff --git a/node_modules/expo/ios/AppDelegates/EXReactRootViewFactory.h b/node_modules/expo/ios/AppDelegates/EXReactRootViewFactory.h
