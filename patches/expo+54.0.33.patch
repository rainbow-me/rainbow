+++ b/node_modules/expo/ios/AppDelegates/EXReactRootViewFactory.h
@@ -25 +25,2 @@
- Calls super `viewWithModuleName:initialProperties:launchOptions:` from `RCTRootViewFactory`.
+ Calls super `viewWithModuleName:initialProperties:launchOptions:bundleConfiguration:devMenuConfiguration:`
+ from `RCTRootViewFactory`.
@@ -29 +30,3 @@
-                      launchOptions:(nullable NSDictionary *)launchOptions;
+                      launchOptions:(nullable NSDictionary *)launchOptions
+                bundleConfiguration:(RCTBundleConfiguration *)bundleConfiguration
+               devMenuConfiguration:(nullable RCTDevMenuConfiguration *)devMenuConfiguration;
