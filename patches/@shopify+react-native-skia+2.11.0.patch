# PATCH CONTEXT
# Enable BuildConfig generation for the current Android Gradle toolchain.
# Use Display P3 on supported Apple displays by default. Synchronize iOS
# drawRect presentation with Core Animation to prevent frozen frames after
# navigation while keeping animation-driven frames asynchronous.
# Remove when upstream owns all three behaviors.

diff --git a/node_modules/@shopify/react-native-skia/android/build.gradle b/node_modules/@shopify/react-native-skia/android/build.gradle
--- a/node_modules/@shopify/react-native-skia/android/build.gradle
+++ b/node_modules/@shopify/react-native-skia/android/build.gradle
@@ -207,5 +207,9 @@ android {
         ndkVersion rootProject.ext.ndkVersion
     }
-
+
+    buildFeatures {
+        buildConfig true
+    }
+
     defaultConfig {
         minSdkVersion safeExtGet('minSdkVersion', DEFAULT_MIN_SDK_VERSION)
diff --git a/node_modules/@shopify/react-native-skia/apple/MetalWindowContext.mm b/node_modules/@shopify/react-native-skia/apple/MetalWindowContext.mm
--- a/node_modules/@shopify/react-native-skia/apple/MetalWindowContext.mm
+++ b/node_modules/@shopify/react-native-skia/apple/MetalWindowContext.mm
@@ -29,22 +29,20 @@ MetalWindowContext::MetalWindowContext(GrDirectContext *directContext,
   _layer.contentsGravity = kCAGravityBottomLeft;
   _layer.drawableSize = CGSizeMake(width, height);
   BOOL supportsWideColor = NO;
-  if (useP3ColorSpace) {
 #if !TARGET_OS_OSX
-    if (@available(iOS 10.0, *)) {
-      supportsWideColor = [UIScreen mainScreen].traitCollection.displayGamut ==
-                          UIDisplayGamutP3;
-    }
+  if (@available(iOS 10.0, *)) {
+    supportsWideColor = [UIScreen mainScreen].traitCollection.displayGamut ==
+                        UIDisplayGamutP3;
+  }
 #else
-    if (@available(macOS 10.12, *)) {
-      NSScreen *screen = [NSScreen mainScreen];
-      NSColorSpace *displayP3 = [NSColorSpace displayP3ColorSpace];
-      if (screen.colorSpace && displayP3) {
-        supportsWideColor = [screen.colorSpace isEqual:displayP3];
-      }
+  if (@available(macOS 10.12, *)) {
+    NSScreen *screen = [NSScreen mainScreen];
+    NSColorSpace *displayP3 = [NSColorSpace displayP3ColorSpace];
+    if (screen.colorSpace && displayP3) {
+      supportsWideColor = [screen.colorSpace isEqual:displayP3];
     }
-#endif // !TARGET_OS_OSX
   }
+#endif // !TARGET_OS_OSX
   if (supportsWideColor) {
     _useP3ColorSpace = true;
   }
diff --git a/node_modules/@shopify/react-native-skia/apple/MetalWindowContext.mm b/node_modules/@shopify/react-native-skia/apple/MetalWindowContext.mm
--- a/node_modules/@shopify/react-native-skia/apple/MetalWindowContext.mm
+++ b/node_modules/@shopify/react-native-skia/apple/MetalWindowContext.mm
@@ -89,4 +89,10 @@
   id<MTLCommandBuffer> commandBuffer([_commandQueue commandBuffer]);
-  [commandBuffer presentDrawable:_currentDrawable];
-  [commandBuffer commit];
+  if (_layer.presentsWithTransaction) {
+    [commandBuffer commit];
+    [commandBuffer waitUntilScheduled];
+    [_currentDrawable present];
+  } else {
+    [commandBuffer presentDrawable:_currentDrawable];
+    [commandBuffer commit];
+  }
   _skSurface = nullptr;
diff --git a/node_modules/@shopify/react-native-skia/apple/SkiaUIView.mm b/node_modules/@shopify/react-native-skia/apple/SkiaUIView.mm
--- a/node_modules/@shopify/react-native-skia/apple/SkiaUIView.mm
+++ b/node_modules/@shopify/react-native-skia/apple/SkiaUIView.mm
@@ -133,7 +133,14 @@
 - (void)drawRect:(CGRect)rect {
   // We override drawRect to ensure we to direct rendering when the
   // underlying OS view needs to render:
   if (_impl != nullptr) {
+#if !TARGET_OS_OSX && !defined(SK_GRAPHITE)
+    CAMetalLayer *layer = (CAMetalLayer *)_impl->getLayer();
+    layer.presentsWithTransaction = YES;
+#endif
     _impl->getDrawView()->redraw();
+#if !TARGET_OS_OSX && !defined(SK_GRAPHITE)
+    layer.presentsWithTransaction = NO;
+#endif
   }
 }
