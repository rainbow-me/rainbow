{
  "compilerOptions": {
    "module": "ESNext",
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-native",
    "lib": ["esnext", "dom"],
    "moduleResolution": "bundler",
    "moduleSuffixes": [".ios", ".android", ""],
    "customConditions": ["react-native", "react-native-legacy-deep-imports"],
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@/swaps": ["./src/__swaps__"],
      "@rainbow-me/config/*": ["./src/config/*"],
      "@rainbow-me/entities": ["./src/entities"],
      "@rainbow-me/routes": ["./src/navigation/routesNames"],
      "logger": ["./src/utils/logger"],
      "react-native-cool-modals": ["./src/react-native-cool-modals"],
      "@nktkas/hyperliquid/api/info": ["./node_modules/@nktkas/hyperliquid/esm/api/info/mod"],
      "@nktkas/hyperliquid/api/exchange": ["./node_modules/@nktkas/hyperliquid/esm/api/exchange/mod"],
      "@nktkas/hyperliquid/api/subscription": ["./node_modules/@nktkas/hyperliquid/esm/api/subscription/mod"],
      "@nktkas/hyperliquid/utils": ["./node_modules/@nktkas/hyperliquid/esm/utils/mod"],
      "@nktkas/hyperliquid/signing": ["./node_modules/@nktkas/hyperliquid/esm/signing/mod"]
    },
    "resolveJsonModule": true
  },
  "globals": ["useTheme", "ios", "android", "web", "__DEV__", "IS_DEV"],
  "exclude": [
    "node_modules",
    "rainbow-scripts",
    "ios",
    "android",
    "src/browser",
    "patches",
    "InjectedJSBundle.js",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "src/codegen/ios",
    "src/codegen/android"
  ]
}
